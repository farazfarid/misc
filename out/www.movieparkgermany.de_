    <script>
        (function() {
            function truncateTitle(titleElement, maxLength) {
                if (!titleElement) return;

                var titleLink = titleElement.querySelector('a');
                var target = titleLink || titleElement;
                var text = target.textContent || '';

                if (text.length > maxLength) {
                    target.textContent = text.slice(0, maxLength);
                }
            }

            window.addEventListener('DOMContentLoaded', function() {
                var title = document.querySelector('.block-notification-title[data-max-length]');
                var maxLength = parseInt(title && title.getAttribute('data-max-length'), 10);

                if (!isNaN(maxLength)) {
                    truncateTitle(title, maxLength);
                }
            });
        })();
    </script>
